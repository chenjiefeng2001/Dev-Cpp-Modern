  /// Every list found in the producer DFM(s), in file order.
  /// Populated in `initialization` -- see the note above on why this
  /// cannot be a typed constant.
  SVG_IMAGE_LISTS: array[0..5] of TSvgImageList;

// Number of extracted lists.
function SvgListCount: Integer;
// Index of the list called AName, or -1. Resolving by NAME is what the
// code needs: the DFM assigns `dmMain.SVGImageListMenuStyle`, so the list
// name is the handle that actually appears at a use site.
function FindSvgListIndex(const AName: String): Integer;

implementation

procedure FillSvgList(var AList: TSvgImageList; const AName: String;
  ASizePx: Integer; const ANames, ASvg: array of String);
var
  I: Integer;
begin
  AList.Name := AName;
  // Zero, not the default, when the DFM declared no Size: the control
  // owns the fallback, so this file only reports what was measured.
  AList.SizePx := ASizePx;
  SetLength(AList.Names, Length(ANames));
  SetLength(AList.Svg, Length(ASvg));
  for I := 0 to High(ANames) do
    AList.Names[I] := ANames[I];
  for I := 0 to High(ASvg) do
    AList.Svg[I] := ASvg[I];
end;

function SvgListCount: Integer;
begin
  Result := High(SVG_IMAGE_LISTS) + 1;
end;

function FindSvgListIndex(const AName: String): Integer;
var
  I: Integer;
begin
  for I := Low(SVG_IMAGE_LISTS) to High(SVG_IMAGE_LISTS) do
    if SVG_IMAGE_LISTS[I].Name = AName then
      Exit(I);
  Result := -1;
end;

initialization
