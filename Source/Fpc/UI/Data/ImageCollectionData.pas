unit ImageCollectionData;

interface

type
  /// One named image of one collection.
  TImageCollItem = record
    /// The DFM's `Name`. Kept because it is what a human reads, and it is
    /// what the combo boxes pair with -- but NEVER a lookup key: names
    /// repeat across a collection, so resolving by name would be ambiguous.
    Name: string;
    /// Path relative to the images root, using forward slashes so the
    /// manifest and the unit mean the same thing on every platform.
    FileName: string;
    Width: Integer;
    Height: Integer;
  end;

  TImageCollectionRec = record
    Name: string;
    /// In index order. Index order IS the contract: every call site drives
    /// these controls by `ImageIndex`, never by name.
    Items: array of TImageCollItem;
  end;

