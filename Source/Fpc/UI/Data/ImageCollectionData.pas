implementation

uses
  Classes;

procedure FillCollection(var AColl: TImageCollectionRec; const AName: string;
  const ANames, AFiles: array of string;
  const AWidths, AHeights: array of Integer);
var
  I: Integer;
begin
  AColl.Name := AName;
  SetLength(AColl.Items, Length(ANames));
  for I := 0 to High(ANames) do
  begin
    AColl.Items[I].Name := ANames[I];
    AColl.Items[I].FileName := AFiles[I];
    AColl.Items[I].Width := AWidths[I];
    AColl.Items[I].Height := AHeights[I];
  end;
end;

function ImageCollectionCount: Integer;
begin
  Result := High(IMAGE_COLLECTIONS) + 1;
end;

function FindImageCollectionIndex(const AName: string): Integer;
var
  I: Integer;
begin
  for I := Low(IMAGE_COLLECTIONS) to High(IMAGE_COLLECTIONS) do
    if IMAGE_COLLECTIONS[I].Name = AName then
      Exit(I);
  Result := -1;
end;

initialization
